  { "type": "function", "id": "p242FnRead", "name": "trigger read (broadcast, no clientId)", "func": "delete msg.path;\nif (msg.ui && msg.ui.store) { delete msg.ui.store; }\nif (msg.ui && msg.ui.clientId) { delete msg.ui.clientId; }\nreturn msg;", "outputs": 1, "noerr": 0, "z": "p242flow", "wires": [["p242Read"]], "x": 420, "y": 340 },

