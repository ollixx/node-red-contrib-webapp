{
    "name": "node-red-contrib-webapp",
    "version": "1.0.0",
    "description": "Declarative web-app nodes for Node-RED.",
    "license": "MIT",
    "author": "Oliver Charlet",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ollixx/node-red-contrib-webapp.git"
    },
    "bugs": {
        "url": "https://github.com/ollixx/node-red-contrib-webapp/issues"
    },
    "homepage": "https://github.com/ollixx/node-red-contrib-webapp#readme",
    "engines": {
        "node": ">=18.5.0"
    },
    "packageManager": "pnpm@10.17.1",
    "main": "nodes/webapp.js",
    "files": [
        "nodes",
        "resources",
        "packages/schema/dist",
        "packages/renderer/dist",
        "examples",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "keywords": [
        "node-red",
        "node-red-contrib",
        "webapp",
        "low-code"
    ],
    "node-red": {
        "version": ">=4.0.0",
        "nodes": {
            "webapp-common": "nodes/webapp-common.js",
            "ui-app": "nodes/structure/ui-app.js",
            "ui-route": "nodes/structure/ui-route.js",
            "ui-dialog": "nodes/structure/ui-dialog.js",
            "ui-component-definition": "nodes/structure/ui-component-definition.js",
            "ui-component-instance": "nodes/structure/ui-component-instance.js",
            "ui-text": "nodes/view/ui-text.js",
            "ui-button": "nodes/view/ui-button.js",
            "ui-table": "nodes/view/ui-table.js",
            "ui-container": "nodes/view/ui-container.js",
            "ui-input": "nodes/view/ui-input.js",
            "ui-select": "nodes/view/ui-select.js",
            "ui-checkbox": "nodes/view/ui-checkbox.js",
            "ui-radio": "nodes/view/ui-radio.js",
            "ui-switch": "nodes/view/ui-switch.js",
            "ui-textarea": "nodes/view/ui-textarea.js",
            "ui-datepicker": "nodes/view/ui-datepicker.js",
            "ui-slider": "nodes/view/ui-slider.js",
            "ui-alert": "nodes/view/ui-alert.js",
            "ui-toast": "nodes/view/ui-toast.js",
            "ui-progress": "nodes/view/ui-progress.js",
            "ui-skeleton": "nodes/view/ui-skeleton.js",
            "ui-badge": "nodes/view/ui-badge.js",
            "ui-empty-state": "nodes/view/ui-empty-state.js",
            "ui-tabs": "nodes/view/ui-tabs.js",
            "ui-tab": "nodes/view/ui-tab.js",
            "ui-accordion": "nodes/view/ui-accordion.js",
            "ui-accordion-section": "nodes/view/ui-accordion-section.js",
            "ui-breadcrumb": "nodes/view/ui-breadcrumb.js",
            "ui-menu": "nodes/view/ui-menu.js",
            "ui-pagination": "nodes/view/ui-pagination.js",
            "ui-stepper": "nodes/view/ui-stepper.js",
            "ui-image": "nodes/view/ui-image.js",
            "ui-icon": "nodes/view/ui-icon.js",
            "ui-list": "nodes/view/ui-list.js",
            "ui-avatar": "nodes/view/ui-avatar.js",
            "ui-divider": "nodes/view/ui-divider.js",
            "ui-log": "nodes/view/ui-log.js",
            "ui-repeat": "nodes/view/ui-repeat.js",
            "ui-store": "nodes/state/ui-store.js",
            "ui-query": "nodes/state/ui-query.js",
            "ui-store-read": "nodes/state/ui-store-read.js",
            "ui-store-action": "nodes/state/ui-store-action.js",
            "ui-query-action": "nodes/state/ui-query-action.js",
            "ui-action": "nodes/behavior/ui-action.js"
        }
    },
    "scripts": {
        "vendor:shoelace": "node scripts/vendor-shoelace.js",
        "build": "pnpm vendor:shoelace && pnpm -r build",
        "build:publish": "pnpm build && node scripts/build-publish.mjs",
        "prepare": "node scripts/vendor-shoelace.js",
        "prepack": "pnpm build:publish >&2",
        "dev:start": "lsof -ti tcp:1881 | xargs kill -9 2>/dev/null || true && node-red --userDir .node-red-dev --port 1881",
        "e2e:server:start": "rm -rf .node-red-e2e && mkdir -p .node-red-e2e/node_modules && cp .node-red-dev/settings.js .node-red-e2e/settings.js && cp examples/customers-crud/flow.json .node-red-e2e/flows.json && ln -sfn ../.. .node-red-e2e/node_modules/node-red-contrib-webapp && node-red --userDir .node-red-e2e --port 1882",
        "example:start": "lsof -ti tcp:1881 | xargs kill -9 2>/dev/null || true && rm -rf .node-red-example && mkdir -p .node-red-example/node_modules && cp .node-red-dev/settings.js .node-red-example/settings.js && cp examples/customers-crud/flow.json .node-red-example/flows.json && ln -sfn ../.. .node-red-example/node_modules/node-red-contrib-webapp && node-red --userDir .node-red-example --port 1881",
        "example:customers-crud": "vitest run packages/schema/test/schema.test.ts packages/runtime/test/customers-crud-example.test.ts packages/renderer/test/renderer.test.ts",
        "lint": "pnpm -r lint",
        "test:e2e": "playwright test",
        "test:e2e:integration": "E2E_INTEGRATION=1 playwright test",
        "test": "pnpm -r test",
        "smoke:pack": "node scripts/smoke-pack.mjs",
        "gen:example": "node scripts/gen-example.js",
        "gen:node-examples": "node scripts/gen-node-examples.js",
        "gen:field-matrix": "node scripts/gen-field-matrix.js",
        "check:roadmap": "node scripts/check-roadmap.js",
        "check:links": "node scripts/check-doc-links.js",
        "check:specs": "node scripts/check-specs.js",
        "check:roundtrip": "node scripts/check-roundtrip.js",
        "check:fields": "node scripts/check-fields.js",
        "check:help": "node scripts/check-help.js",
        "check:guide": "node scripts/check-guide.js",
        "check:no-crash": "node scripts/check-no-crash.js",
        "check:binding-docs": "node scripts/check-binding-docs.js",
        "test:specs": "vitest run scripts/check-specs.test.ts scripts/check-roundtrip.test.ts scripts/check-fields.test.ts scripts/check-help.test.ts scripts/check-guide.test.ts scripts/check-no-crash.test.ts scripts/check-binding-docs.test.ts",
        "validate": "pnpm check:roadmap && pnpm check:links && pnpm check:specs && pnpm check:roundtrip && pnpm check:fields && pnpm check:help && pnpm check:guide && pnpm check:no-crash && pnpm check:binding-docs && pnpm lint && pnpm test && pnpm test:specs && pnpm build",
        "test:showcase": "SHOWCASE=1 playwright test",
        "show-report": "playwright show-report"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@playwright/test": "^1.58.2",
        "@shoelace-style/shoelace": "2.20.1",
        "esbuild": "0.27.4",
        "eslint": "^9.36.0",
        "fast-check": "^4.8.0",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.44.1",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "zod": "^4.3.6"
    }
}
