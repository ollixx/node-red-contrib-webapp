{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec playwright test)",
      "Bash(pnpm exec playwright test *)",
      "Bash(grep -n *)",
      "Bash(grep -rn *)",
      "Bash(grep -l *)",
      "Bash(grep -r *)",
      "Bash(sed -n *)",
      "Bash(find . *)",
      "Bash(find .ai *)",
      "Bash(find ./nodes *)",
      "Read(//Users/ollix/repos/node-red-contrib-webapp/**)",
      "Edit(//Users/ollix/repos/node-red-contrib-webapp/**)",
      "Write(//Users/ollix/repos/node-red-contrib-webapp/**)"
    ],
    "deny": [
      "Edit(//Users/ollix/repos/node-red-contrib-webapp/.node-red-dev/flows.json)",
      "Write(//Users/ollix/repos/node-red-contrib-webapp/.node-red-dev/flows.json)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/record-run-cost.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/record-run-cost.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
