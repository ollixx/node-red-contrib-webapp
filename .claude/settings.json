{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm exec playwright test)",
      "Bash(pnpm exec playwright test *)",
      "Bash(grep -n *)",
      "Bash(grep -rn *)",
      "Bash(grep -l *)",
      "Bash(grep -r *)",
      "Bash(sed -n *)",
      "Bash(find . *)",
      "Bash(find .ai *)",
      "Bash(find ./nodes *)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/record-run-cost.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/record-run-cost.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
