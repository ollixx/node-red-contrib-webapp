[
  {
    "id": "ex-ui-navigation",
    "type": "tab",
    "label": "ui-navigation example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "navApp",
    "type": "ui-app",
    "name": "Navigation App",
    "uiId": "navApp",
    "root": "navApp",
    "layout": "app",
    "z": "ex-ui-navigation",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "navProducts",
    "type": "ui-route",
    "name": "navProducts",
    "uiId": "navProducts",
    "path": "/products",
    "app": "navApp",
    "layout": "vertical",
    "z": "ex-ui-navigation",
    "x": 120,
    "y": 260,
    "wires": [
      []
    ]
  },
  {
    "id": "navAbout",
    "type": "ui-route",
    "name": "navAbout",
    "uiId": "navAbout",
    "path": "/about",
    "app": "navApp",
    "layout": "vertical",
    "z": "ex-ui-navigation",
    "x": 120,
    "y": 340,
    "wires": [
      []
    ]
  },
  {
    "id": "mainNav",
    "type": "ui-navigation",
    "name": "Main Nav",
    "uiId": "mainNav",
    "app": "navApp",
    "mount": "navApp.nav",
    "links": "[{\"label\":\"Home\",\"to\":\"/\"},{\"label\":\"Products\",\"to\":\"/products\"},{\"label\":\"About\",\"to\":\"/about\"}]",
    "z": "ex-ui-navigation",
    "x": 480,
    "y": 180,
    "wires": [
      [
        "navDbg"
      ]
    ]
  },
  {
    "id": "homeContent",
    "type": "ui-text",
    "name": "home content",
    "uiId": "homeContent",
    "app": "navApp",
    "mount": "navApp.content",
    "z": "ex-ui-navigation",
    "x": 480,
    "y": 280,
    "wires": [
      []
    ],
    "text": "Home page"
  },
  {
    "id": "productsContent",
    "type": "ui-text",
    "name": "products content",
    "uiId": "productsContent",
    "app": "navApp",
    "mount": "navProducts.content",
    "z": "ex-ui-navigation",
    "x": 480,
    "y": 260,
    "wires": [
      []
    ],
    "text": "Products page"
  },
  {
    "id": "aboutContent",
    "type": "ui-text",
    "name": "about content",
    "uiId": "aboutContent",
    "app": "navApp",
    "mount": "navAbout.content",
    "z": "ex-ui-navigation",
    "x": 480,
    "y": 340,
    "wires": [
      []
    ],
    "text": "About page"
  },
  {
    "id": "navDbg",
    "type": "debug",
    "name": "navigate events",
    "z": "ex-ui-navigation",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-links",
    "type": "inject",
    "name": "Update nav links",
    "z": "ex-ui-navigation",
    "x": 120,
    "y": 480,
    "payload": "[{\"label\":\"Home\",\"to\":\"/\"},{\"label\":\"FAQ\",\"to\":\"/about\"}]",
    "payloadType": "json",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "mainNav"
      ]
    ]
  }
