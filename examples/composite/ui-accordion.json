[
  {
    "id": "ex-ui-accordion",
    "type": "tab",
    "label": "ui-accordion example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "accApp",
    "type": "ui-app",
    "name": "Accordion App",
    "uiId": "accApp",
    "root": "accApp",
    "layout": "app",
    "z": "ex-ui-accordion",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "accNode",
    "type": "ui-accordion",
    "name": "FAQ accordion",
    "uiId": "accNode",
    "app": "accApp",
    "mount": "accApp.content",
    "z": "ex-ui-accordion",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "accDbg"
      ]
    ],
    "sections": "[{\"id\":\"q1\",\"label\":\"What is node-red-contrib-webapp?\"},{\"id\":\"q2\",\"label\":\"How does routing work?\"},{\"id\":\"q3\",\"label\":\"Can I use it with my existing flows?\"}]",
    "openSection": {
      "kind": "literal",
      "value": "q1"
    }
  },
  {
    "id": "accQ1",
    "type": "ui-text",
    "name": "q1 content",
    "uiId": "accQ1",
    "app": "accApp",
    "mount": "section:q1",
    "z": "ex-ui-accordion",
    "x": 700,
    "y": 200,
    "wires": [
      []
    ],
    "text": "A set of declarative UI nodes for Node-RED to build web apps without custom HTML."
  },
  {
    "id": "accQ2",
    "type": "ui-text",
    "name": "q2 content",
    "uiId": "accQ2",
    "app": "accApp",
    "mount": "section:q2",
    "z": "ex-ui-accordion",
    "x": 700,
    "y": 280,
    "wires": [
      []
    ],
    "text": "Each ui-route node defines a URL path. Navigation is handled by ui-action nodes."
  },
  {
    "id": "accQ3",
    "type": "ui-text",
    "name": "q3 content",
    "uiId": "accQ3",
    "app": "accApp",
    "mount": "section:q3",
    "z": "ex-ui-accordion",
    "x": 700,
    "y": 360,
    "wires": [
      []
    ],
    "text": "Yes — nodes emit standard msg.ui events on their output port, compatible with any Node-RED node."
  },
  {
    "id": "accDbg",
    "type": "debug",
    "name": "sectionOpen / sectionClose events",
    "z": "ex-ui-accordion",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-section",
    "type": "inject",
    "name": "Open Q2 section",
    "z": "ex-ui-accordion",
    "x": 120,
    "y": 480,
    "payload": "q2",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "accNode"
      ]
    ]
  }
]
