    "y": 480,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "fn-show"
      ]
    ]
  },
  {
    "id": "fn-show",
    "type": "function",
    "name": "→ show",
