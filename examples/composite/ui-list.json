[
  {
    "id": "ex-ui-list",
    "type": "tab",
    "label": "ui-list example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "listApp",
    "type": "ui-app",
    "name": "List App",
    "uiId": "listApp",
    "root": "listApp",
    "layout": "app",
    "z": "ex-ui-list",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "listRoute",
    "type": "ui-route",
    "name": "listRoute",
    "uiId": "listRoute",
    "path": "/",
    "parent": "listApp",
    "layoutId": "vertical",
    "z": "ex-ui-list",
    "x": 120,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "listStore",
    "type": "ui-store",
    "name": "items store",
    "uiId": "listStore",
    "parent": "listApp",
    "z": "ex-ui-list",
    "x": 480,
    "y": 380,
    "wires": [
      []
    ],
    "statePath": "items",
    "initialValue": "[{\"id\":\"1\",\"label\":\"First item\",\"description\":\"A short description\"},{\"id\":\"2\",\"label\":\"Second item\",\"description\":\"Another description\"},{\"id\":\"3\",\"label\":\"Third item\"}]"
  },
  {
    "id": "listNode",
    "type": "ui-list",
    "name": "items list",
    "uiId": "listNode",
    "parent": "listApp",
    "mount": "listRoute.content",
    "z": "ex-ui-list",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "listDbg"
      ]
    ],
    "items": {
      "kind": "state",
      "path": "items"
    }
  },
  {
    "id": "listDbg",
    "type": "debug",
    "name": "itemClick events",
    "z": "ex-ui-list",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-items",
    "type": "inject",
    "name": "Replace items",
    "z": "ex-ui-list",
    "x": 120,
    "y": 480,
    "payload": "[{\"id\":\"a\",\"label\":\"Alpha\"},{\"id\":\"b\",\"label\":\"Beta\"}]",
    "payloadType": "json",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "listStore"
      ]
    ]
  },
  {
    "id": "inj-clear",
    "type": "inject",
    "name": "Clear list",
    "z": "ex-ui-list",
    "x": 120,
    "y": 560,
    "payload": "[]",
    "payloadType": "json",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "listStore"
      ]
    ]
  }
]
