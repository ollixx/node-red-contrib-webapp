[
  {
    "id": "ex-ui-tabs",
    "type": "tab",
    "label": "ui-tabs example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "tabsApp",
    "type": "ui-app",
    "name": "Tabs App",
    "uiId": "tabsApp",
    "root": "tabsApp",
    "layout": "app",
    "z": "ex-ui-tabs",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "tabsRoute",
    "type": "ui-route",
    "name": "tabsRoute",
    "uiId": "tabsRoute",
    "path": "/",
    "parent": "tabsApp",
    "layoutId": "vertical",
    "z": "ex-ui-tabs",
    "x": 120,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "tabsNode",
    "type": "ui-tabs",
    "name": "tabs",
    "uiId": "tabsNode",
    "parent": "tabsApp",
    "mount": "tabsRoute.content",
    "z": "ex-ui-tabs",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "tabsDbg"
      ]
    ],
    "tabs": "[{\"id\":\"overview\",\"label\":\"Overview\"},{\"id\":\"details\",\"label\":\"Details\"},{\"id\":\"history\",\"label\":\"History\"}]",
    "value": {
      "kind": "literal",
      "value": "overview"
    }
  },
  {
    "id": "tabOverview",
    "type": "ui-text",
    "name": "overview content",
    "uiId": "tabOverview",
    "parent": "tabsApp",
    "mount": "tabsNode.overview",
    "z": "ex-ui-tabs",
    "x": 700,
    "y": 200,
    "wires": [
      []
    ],
    "text": "Overview content here."
  },
  {
    "id": "tabDetails",
    "type": "ui-text",
    "name": "details content",
    "uiId": "tabDetails",
    "parent": "tabsApp",
    "mount": "tabsNode.details",
    "z": "ex-ui-tabs",
    "x": 700,
    "y": 280,
    "wires": [
      []
    ],
    "text": "Details content here."
  },
  {
    "id": "tabHistory",
    "type": "ui-text",
    "name": "history content",
    "uiId": "tabHistory",
    "parent": "tabsApp",
    "mount": "tabsNode.history",
    "z": "ex-ui-tabs",
    "x": 700,
    "y": 360,
    "wires": [
      []
    ],
    "text": "History content here."
  },
  {
    "id": "tabsDbg",
    "type": "debug",
    "name": "tabChange events",
    "z": "ex-ui-tabs",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-tab",
    "type": "inject",
    "name": "Switch to Details tab",
    "z": "ex-ui-tabs",
    "x": 120,
    "y": 480,
    "payload": "details",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "tabsNode"
      ]
    ]
  }
]
