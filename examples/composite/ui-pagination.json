[
  {
    "id": "ex-ui-pagination",
    "type": "tab",
    "label": "ui-pagination example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "pagApp",
    "type": "ui-app",
    "name": "Pagination App",
    "uiId": "pagApp",
    "root": "pagApp",
    "layout": "app",
    "z": "ex-ui-pagination",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "pageStore",
    "type": "ui-store",
    "name": "page store",
    "uiId": "pageStore",
    "app": "pagApp",
    "z": "ex-ui-pagination",
    "x": 480,
    "y": 380,
    "wires": [
      []
    ],
    "statePath": "page",
    "initialValue": "1"
  },
  {
    "id": "pagNode",
    "type": "ui-pagination",
    "name": "pager",
    "uiId": "pagNode",
    "app": "pagApp",
    "mount": "pagApp.content",
    "z": "ex-ui-pagination",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "pagDbg"
      ]
    ],
    "page": {
      "kind": "state",
      "path": "page"
    },
    "pageCount": 10
  },
  {
    "id": "pageDisplay",
    "type": "ui-text",
    "name": "current page",
    "uiId": "pageDisplay",
    "app": "pagApp",
    "mount": "pagApp.content",
    "z": "ex-ui-pagination",
    "x": 480,
    "y": 360,
    "wires": [
      []
    ],
    "value": {
      "kind": "state",
      "path": "page"
    }
  },
  {
    "id": "pagDbg",
    "type": "debug",
    "name": "pageChange events",
    "z": "ex-ui-pagination",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-page3",
    "type": "inject",
    "name": "Jump to page 3",
    "z": "ex-ui-pagination",
    "x": 120,
    "y": 480,
    "payload": "3",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "pageStore"
      ]
    ]
  },
  {
    "id": "inj-page1",
    "type": "inject",
    "name": "Jump to page 1",
    "z": "ex-ui-pagination",
    "x": 120,
    "y": 560,
    "payload": "1",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "pageStore"
      ]
    ]
  },
  {
    "id": "fn-updatePage",
    "type": "function",
    "name": "→ update page store",
    "z": "ex-ui-pagination",
    "func": "msg.payload = String(msg.ui.params?.page ?? msg.ui.page ?? 1);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 640,
    "wires": [
      [
        "pageStore"
      ]
    ]
  }
]
