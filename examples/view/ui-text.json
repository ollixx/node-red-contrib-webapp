[
  {
    "id": "ex-ui-text",
    "type": "tab",
    "label": "ui-text example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "textApp",
    "type": "ui-app",
    "name": "Text App",
    "uiId": "textApp",
    "root": "textApp",
    "layout": "app",
    "z": "ex-ui-text",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "textStore",
    "type": "ui-store",
    "name": "text store",
    "uiId": "textStore",
    "parent": "textApp",
    "z": "ex-ui-text",
    "x": 480,
    "y": 380,
    "wires": [
      []
    ],
    "statePath": "label",
    "initialValue": "\"Hello from store\""
  },
  {
    "id": "staticText",
    "type": "ui-text",
    "name": "static text",
    "uiId": "staticText",
    "parent": "textApp",
    "mount": "textApp.content",
    "z": "ex-ui-text",
    "x": 480,
    "y": 280,
    "wires": [
      []
    ],
    "text": "Static text — always shows this string."
  },
  {
    "id": "textNode",
    "type": "ui-text",
    "name": "store-bound text",
    "uiId": "textNode",
    "parent": "textApp",
    "mount": "textApp.content",
    "z": "ex-ui-text",
    "x": 480,
    "y": 360,
    "wires": [
      []
    ],
    "value": {
      "kind": "state",
      "path": "label"
    }
  },
  {
    "id": "inj-newVal",
    "type": "inject",
    "name": "Update text via store",
    "z": "ex-ui-text",
    "x": 120,
    "y": 480,
    "payload": "Updated at runtime!",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "textStore"
      ]
    ]
  },
  {
    "id": "inj-direct",
    "type": "inject",
    "name": "Update static text directly",
    "z": "ex-ui-text",
    "x": 120,
    "y": 560,
    "payload": "Directly updated!",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "staticText"
      ]
    ]
  },
  {
    "id": "inj-show",
    "type": "inject",
    "name": "show",
    "z": "ex-ui-text",
    "x": 120,
    "y": 640,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "fn-show"
      ]
    ]
  },
  {
    "id": "fn-show",
    "type": "function",
    "name": "→ show",
    "z": "ex-ui-text",
    "func": "msg.ui = { component: { op: \"show\" } };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 640,
    "wires": [
      [
        "textNode"
      ]
    ]
  },
  {
    "id": "inj-hide",
    "type": "inject",
    "name": "hide",
    "z": "ex-ui-text",
    "x": 120,
    "y": 720,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "fn-hide"
      ]
    ]
  },
  {
    "id": "fn-hide",
    "type": "function",
    "name": "→ hide",
    "z": "ex-ui-text",
    "func": "msg.ui = { component: { op: \"hide\" } };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 720,
    "wires": [
      [
        "textNode"
      ]
    ]
  }
]
