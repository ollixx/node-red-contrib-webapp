    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "alertNode"
      ]
    ]
  },
  {
    "id": "inj-show",
    "type": "inject",
    "name": "show",
    "z": "ex-ui-alert",
    "x": 120,
    "y": 700,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "fn-show"
      ]
    ]
  },
  {
    "id": "fn-show",
    "type": "function",
    "name": "→ show",
    "z": "ex-ui-alert",
    "func": "msg.ui = { component: { op: \"show\" } };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 700,
    "wires": [
      [
        "alertNode"
      ]
    ]
  },
