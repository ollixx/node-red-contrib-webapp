[
  {
    "id": "ex-ui-input",
    "type": "tab",
    "label": "ui-input example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "inputApp",
    "type": "ui-app",
    "name": "ui-input App",
    "uiId": "inputApp",
    "root": "inputApp",
    "layout": "app",
    "z": "ex-ui-input",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "inputRoute",
    "type": "ui-route",
    "name": "inputRoute",
    "uiId": "inputRoute",
    "path": "/",
    "parent": "inputApp",
    "layoutId": "vertical",
    "z": "ex-ui-input",
    "x": 120,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "inputNode",
    "type": "ui-input",
    "name": "inputNode",
    "uiId": "inputNode",
    "parent": "inputApp",
    "mount": "inputRoute.content",
    "z": "ex-ui-input",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "inputNodeDbg"
      ]
    ],
    "label": "Full name",
    "inputType": "text",
    "placeholder": "Enter your name",
    "value": {
      "kind": "literal",
      "value": ""
    }
  },
  {
    "id": "inputNodeDbg",
    "type": "debug",
    "name": "change / submit events",
    "z": "ex-ui-input",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-val",
    "type": "inject",
    "name": "Set value",
    "z": "ex-ui-input",
    "x": 120,
    "y": 500,
    "payload": "Jane Doe",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "inputNode"
      ]
    ]
  },
  {
    "id": "inj-disable",
    "type": "inject",
    "name": "disable",
    "z": "ex-ui-input",
    "x": 120,
    "y": 580,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "fn-disable"
      ]
    ]
  },
  {
    "id": "fn-disable",
    "type": "function",
    "name": "→ disable",
    "z": "ex-ui-input",
    "func": "msg.ui = { component: { op: \"disable\" } };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 380,
    "y": 580,
    "wires": [
      [
        "inputNode"
      ]
    ]
  },
