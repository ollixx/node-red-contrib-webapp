[
  {
    "id": "ex-ui-slider",
    "type": "tab",
    "label": "ui-slider example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "sliderApp",
    "type": "ui-app",
    "name": "ui-slider App",
    "uiId": "sliderApp",
    "root": "sliderApp",
    "layout": "app",
    "z": "ex-ui-slider",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "sliderNode",
    "type": "ui-slider",
    "name": "sliderNode",
    "uiId": "sliderNode",
    "app": "sliderApp",
    "mount": "sliderApp.content",
    "z": "ex-ui-slider",
    "x": 480,
    "y": 280,
    "wires": [
      [
        "sliderNodeDbg"
      ]
    ],
    "label": "Volume",
    "min": 0,
    "max": 100,
    "step": 5,
    "showValue": true,
    "value": {
      "kind": "literal",
      "value": 50
    }
  },
  {
    "id": "sliderNodeDbg",
    "type": "debug",
    "name": "change / submit events",
    "z": "ex-ui-slider",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
