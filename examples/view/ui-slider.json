  {
    "id": "fn-disable",
    "type": "function",
    "name": "→ disable",
    "z": "ex-ui-slider",
    "func": "msg.ui = { component: { op: \"disable\" } };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
