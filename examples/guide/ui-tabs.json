[
    {
        "id": "guide-ui-tabs",
        "type": "tab",
        "label": "Guide: ui-tabs",
        "disabled": false,
        "info": "User-guide example for ui-tabs (docs/guide/nodes/ui-tabs.md) and ui-tab (docs/guide/nodes/ui-tab.md). Import, deploy, open /webapp/guideTabs/. Two ui-tab children define the tabs; activeTab reads a store value and tabChange writes the chosen tab id back (two-way loop)."
    },
    {
        "id": "guideTabs",
        "type": "ui-app",
        "name": "Tabs demo",
        "uiId": "guideTabs",
        "root": "guideTabs",
        "layout": "app",
        "z": "guide-ui-tabs",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gTabsStore",
        "type": "ui-store",
        "name": "Active tab store",
        "uiId": "gTabsStore",
        "app": "guideTabs",
        "statePath": "activeTab",
        "initialValue": "\"overview\"",
        "persist": false,
        "scope": "any",
        "z": "guide-ui-tabs",
        "x": 120,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "gTabsNode",
        "type": "ui-tabs",
        "name": "View tabs",
        "uiId": "gTabsNode",
        "app": "guideTabs",
        "mount": "guideTabs.content",
        "activeTab": { "kind": "state", "path": "activeTab" },
        "variant": "line",
        "events": "[\"tabChange\"]",
        "order": "1",
        "z": "guide-ui-tabs",
        "x": 360,
        "y": 120,
        "wires": [["gTabsToPayload"]]
    },
    {
        "id": "gTabOverview",
        "type": "ui-tab",
        "name": "Overview tab",
        "uiId": "gTabOverview",
        "app": "guideTabs",
        "mount": "ui-tabs:gTabsNode/content",
        "label": { "kind": "literal", "value": "Overview" },
        "icon": "",
        "order": "0",
        "z": "guide-ui-tabs",
        "x": 360,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "gTabDetails",
        "type": "ui-tab",
        "name": "Details tab",
        "uiId": "gTabDetails",
        "app": "guideTabs",
        "mount": "ui-tabs:gTabsNode/content",
        "label": { "kind": "literal", "value": "Details" },
        "icon": "",
        "order": "1",
        "z": "guide-ui-tabs",
        "x": 360,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "gTabOverviewBody",
        "type": "ui-text",
        "name": "Overview body",
        "uiId": "gTabOverviewBody",
        "app": "guideTabs",
        "mount": "ui-tab:gTabOverview/content",
        "text": "Overview panel content.",
        "value": { "kind": "literal", "value": "Overview panel content." },
        "order": "0",
        "z": "guide-ui-tabs",
        "x": 600,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "gTabDetailsBody",
        "type": "ui-text",
        "name": "Details body",
        "uiId": "gTabDetailsBody",
        "app": "guideTabs",
        "mount": "ui-tab:gTabDetails/content",
        "text": "Details panel content.",
        "value": { "kind": "literal", "value": "Details panel content." },
        "order": "0",
        "z": "guide-ui-tabs",
        "x": 600,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "gTabsToPayload",
        "type": "change",
        "name": "params.tabId → payload",
        "z": "guide-ui-tabs",
        "rules": [
            { "t": "set", "p": "payload", "pt": "msg", "to": "ui.params.tabId", "tot": "msg" }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 620,
        "y": 120,
        "wires": [["gTabsWriteBack"]]
    },
    {
        "id": "gTabsWriteBack",
        "type": "ui-store-action",
        "name": "Write active tab",
        "uiId": "gTabsWriteBack",
        "app": "guideTabs",
        "store": "gTabsStore",
        "op": "set",
        "path": "",
        "mode": "reference",
        "z": "guide-ui-tabs",
        "x": 860,
        "y": 120,
        "wires": [[]]
    }
]
