[
    {
        "id": "guide-ui-text",
        "type": "tab",
        "label": "Guide: ui-text",
        "disabled": false,
        "info": "User-guide example for ui-text (docs/guide/nodes/ui-text.md). Import, deploy, open /webapp/guideText/. A static heading and a store-bound body value; click the inject to update the store and watch the body update live."
    },
    {
        "id": "guideText",
        "type": "ui-app",
        "name": "Text demo",
        "uiId": "guideText",
        "root": "guideText",
        "layout": "app",
        "z": "guide-ui-text",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gTxtStore",
        "type": "ui-store",
        "name": "Greeting store",
        "uiId": "gTxtStore",
        "app": "guideText",
        "statePath": "greeting",
        "initialValue": "\"Hello from the store.\"",
        "persist": false,
        "scope": "any",
        "z": "guide-ui-text",
        "x": 120,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "gTxtHeading",
        "type": "ui-text",
        "name": "Heading",
        "uiId": "gTxtHeading",
        "app": "guideText",
        "mount": "guideText.content",
        "text": "Welcome",
        "value": { "kind": "literal", "value": "Welcome" },
        "style": "heading-1",
        "variant": "primary",
        "display": "text",
        "order": "1",
        "z": "guide-ui-text",
        "x": 340,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "gTxtBody",
        "type": "ui-text",
        "name": "Body (store-bound)",
        "uiId": "gTxtBody",
        "app": "guideText",
        "mount": "guideText.content",
        "text": "",
        "value": { "kind": "state", "path": "greeting" },
        "style": "body",
        "variant": "default",
        "display": "text",
        "order": "2",
        "z": "guide-ui-text",
        "x": 340,
        "y": 120,
        "wires": [[]]
    },
    {
        "id": "gTxtInject",
        "type": "inject",
        "name": "Set greeting",
        "props": [{ "p": "payload" }],
        "payload": "Updated live at runtime.",
        "payloadType": "str",
        "z": "guide-ui-text",
        "x": 130,
        "y": 240,
        "wires": [["gTxtStoreWrite"]]
    },
    {
        "id": "gTxtStoreWrite",
        "type": "ui-store-action",
        "name": "write greeting",
        "uiId": "gTxtStoreWrite",
        "app": "guideText",
        "store": "gTxtStore",
        "op": "set",
        "path": "",
        "mode": "reference",
        "z": "guide-ui-text",
        "x": 360,
        "y": 240,
        "wires": [[]]
    }
]
