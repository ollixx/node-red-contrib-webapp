[
    {
        "id": "guide-ui-accordion",
        "type": "tab",
        "label": "Guide: ui-accordion",
        "disabled": false,
        "info": "User-guide example for ui-accordion (docs/guide/nodes/ui-accordion.md) and ui-accordion-section (docs/guide/nodes/ui-accordion-section.md). Import, deploy, open /webapp/guideAccordion/. Three section children, single-open; openSection reads a store and sectionOpen writes the opened id back (two-way loop)."
    },
    {
        "id": "guideAccordion",
        "type": "ui-app",
        "name": "Accordion demo",
        "uiId": "guideAccordion",
        "root": "guideAccordion",
        "layout": "app",
        "z": "guide-ui-accordion",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gAccStore",
        "type": "ui-store",
        "name": "Open section store",
        "uiId": "gAccStore",
        "app": "guideAccordion",
        "statePath": "openSection",
        "initialValue": "\"q1\"",
        "persist": false,
        "scope": "any",
        "z": "guide-ui-accordion",
        "x": 120,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "gAccNode",
        "type": "ui-accordion",
        "name": "FAQ accordion",
        "uiId": "gAccNode",
        "app": "guideAccordion",
        "mount": "guideAccordion.content",
        "openSection": { "kind": "state", "path": "openSection" },
        "multiple": false,
        "events": "[\"sectionOpen\",\"sectionClose\"]",
        "order": "1",
        "z": "guide-ui-accordion",
        "x": 360,
        "y": 120,
        "wires": [["gAccToPayload"]]
    },
    {
        "id": "gAccQ1",
        "type": "ui-accordion-section",
        "name": "Q1 section",
        "uiId": "gAccQ1",
        "app": "guideAccordion",
        "mount": "ui-accordion:gAccNode/content",
        "label": { "kind": "literal", "value": "What is node-red-contrib-webapp?" },
        "icon": "",
        "order": "0",
        "z": "guide-ui-accordion",
        "x": 360,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "gAccQ2",
        "type": "ui-accordion-section",
        "name": "Q2 section",
        "uiId": "gAccQ2",
        "app": "guideAccordion",
        "mount": "ui-accordion:gAccNode/content",
        "label": { "kind": "literal", "value": "How does routing work?" },
        "icon": "",
        "order": "1",
        "z": "guide-ui-accordion",
        "x": 360,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "gAccQ3",
        "type": "ui-accordion-section",
        "name": "Q3 section",
        "uiId": "gAccQ3",
        "app": "guideAccordion",
        "mount": "ui-accordion:gAccNode/content",
        "label": { "kind": "literal", "value": "Can I use it with my existing flows?" },
        "icon": "",
        "order": "2",
        "z": "guide-ui-accordion",
        "x": 360,
        "y": 320,
        "wires": [[]]
    },
    {
        "id": "gAccQ1Body",
        "type": "ui-text",
        "name": "Q1 answer",
        "uiId": "gAccQ1Body",
        "app": "guideAccordion",
        "mount": "ui-accordion-section:gAccQ1/content",
        "text": "A set of declarative UI nodes for Node-RED to build web apps without custom HTML.",
        "value": { "kind": "literal", "value": "A set of declarative UI nodes for Node-RED to build web apps without custom HTML." },
        "order": "0",
        "z": "guide-ui-accordion",
        "x": 620,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "gAccQ2Body",
        "type": "ui-text",
        "name": "Q2 answer",
        "uiId": "gAccQ2Body",
        "app": "guideAccordion",
        "mount": "ui-accordion-section:gAccQ2/content",
        "text": "Each ui-route defines a URL path; navigation is a ui-action navigate.",
        "value": { "kind": "literal", "value": "Each ui-route defines a URL path; navigation is a ui-action navigate." },
        "order": "0",
        "z": "guide-ui-accordion",
        "x": 620,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "gAccQ3Body",
        "type": "ui-text",
        "name": "Q3 answer",
        "uiId": "gAccQ3Body",
        "app": "guideAccordion",
        "mount": "ui-accordion-section:gAccQ3/content",
        "text": "Yes — nodes emit standard msg.ui events on their output port.",
        "value": { "kind": "literal", "value": "Yes — nodes emit standard msg.ui events on their output port." },
        "order": "0",
        "z": "guide-ui-accordion",
        "x": 620,
        "y": 320,
        "wires": [[]]
    },
    {
        "id": "gAccToPayload",
        "type": "change",
        "name": "params.sectionId → payload",
        "z": "guide-ui-accordion",
        "rules": [
            { "t": "set", "p": "payload", "pt": "msg", "to": "ui.params.sectionId", "tot": "msg" }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 640,
        "y": 120,
        "wires": [["gAccWriteBack"]]
    },
    {
        "id": "gAccWriteBack",
        "type": "ui-store-action",
        "name": "Write open section",
        "uiId": "gAccWriteBack",
        "app": "guideAccordion",
        "store": "gAccStore",
        "op": "set",
        "path": "",
        "mode": "reference",
        "z": "guide-ui-accordion",
        "x": 900,
        "y": 120,
        "wires": [[]]
    }
]
