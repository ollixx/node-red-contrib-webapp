[
    {
        "id": "guide-actions-events",
        "type": "tab",
        "label": "Guide: Actions & Events",
        "disabled": false,
        "info": "Example for the Actions & Events guide (docs/guide/guides/actions-events.md). Import, deploy, then open /webapp/actionsApp/ — buttons that hide/show a card via wired ui-actions, and a reference-mode ui-store-action that records the last click without any wire to the store."
    },
    {
        "id": "actionsApp",
        "type": "ui-app",
        "name": "Actions demo",
        "uiId": "actionsApp",
        "root": "actionsApp",
        "title": "Actions demo",
        "layout": "app",
        "z": "guide-actions-events",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gaeCard",
        "type": "ui-container",
        "name": "Toggle card",
        "uiId": "gaeCard",
        "app": "actionsApp",
        "mount": "actionsApp.content",
        "layout": "vertical",
        "order": "1",
        "z": "guide-actions-events",
        "x": 320,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "gaeCardText",
        "type": "ui-text",
        "name": "Card text",
        "uiId": "gaeCardText",
        "app": "actionsApp",
        "mount": "gaeCard.content",
        "text": "This card is hidden and shown by wired ui-actions.",
        "z": "guide-actions-events",
        "x": 540,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "gaeHideButton",
        "type": "ui-button",
        "name": "Hide card",
        "uiId": "gaeHideButton",
        "app": "actionsApp",
        "mount": "actionsApp.content",
        "label": "Hide card",
        "order": "2",
        "z": "guide-actions-events",
        "x": 320,
        "y": 140,
        "wires": [["gaeHideAction", "gaeRecordClick"]]
    },
    {
        "id": "gaeShowButton",
        "type": "ui-button",
        "name": "Show card",
        "uiId": "gaeShowButton",
        "app": "actionsApp",
        "mount": "actionsApp.content",
        "label": "Show card",
        "order": "3",
        "z": "guide-actions-events",
        "x": 320,
        "y": 220,
        "wires": [["gaeShowAction", "gaeRecordClick"]]
    },
    {
        "id": "gaeHideAction",
        "type": "ui-action",
        "name": "hide → card",
        "uiId": "gaeHideAction",
        "app": "actionsApp",
        "actionType": "hide",
        "z": "guide-actions-events",
        "x": 540,
        "y": 140,
        "wires": [["gaeCard"]]
    },
    {
        "id": "gaeShowAction",
        "type": "ui-action",
        "name": "show → card",
        "uiId": "gaeShowAction",
        "app": "actionsApp",
        "actionType": "show",
        "z": "guide-actions-events",
        "x": 540,
        "y": 220,
        "wires": [["gaeCard"]]
    },
    {
        "id": "gaeClickStore",
        "type": "ui-store",
        "name": "Last click store",
        "uiId": "gaeClickStore",
        "app": "actionsApp",
        "statePath": "clicks",
        "initialValue": "{\"last\":\"(no click yet)\"}",
        "z": "guide-actions-events",
        "x": 120,
        "y": 320,
        "wires": [[]]
    },
    {
        "id": "gaeRecordClick",
        "type": "function",
        "name": "payload = which button",
        "func": "msg.payload = (msg.ui && msg.ui.sourceId ? msg.ui.sourceId : \"unknown\") + \" at \" + new Date().toLocaleTimeString();\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "z": "guide-actions-events",
        "x": 560,
        "y": 320,
        "wires": [["gaeStoreAction"]]
    },
    {
        "id": "gaeStoreAction",
        "type": "ui-store-action",
        "name": "set clicks.last (reference)",
        "uiId": "gaeStoreAction",
        "app": "actionsApp",
        "store": "gaeClickStore",
        "op": "set",
        "path": "last",
        "mode": "reference",
        "z": "guide-actions-events",
        "x": 800,
        "y": 320,
        "wires": [[]]
    },
    {
        "id": "gaeLastClick",
        "type": "ui-text",
        "name": "Last click",
        "uiId": "gaeLastClick",
        "app": "actionsApp",
        "mount": "actionsApp.content",
        "value": {
            "kind": "store",
            "path": "gaeClickStore",
            "subPath": { "kind": "literal", "value": "last" }
        },
        "order": "4",
        "z": "guide-actions-events",
        "x": 320,
        "y": 400,
        "wires": [[]]
    }
]
