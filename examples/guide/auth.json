[
    {
        "id": "guide-auth",
        "type": "tab",
        "label": "Guide: Auth",
        "disabled": false,
        "info": "Example for the Auth guide (docs/guide/guides/auth.md). Import, deploy, then open /webapp/authApp/ — a user binding with fallback, a guarded /admin route (requiresGroup: admins), and an admin-only button hidden via the reactive user pattern. Auth mode ships as 'none' so the app is open; switch the ui-app's auth mode to 'trusted-header' (behind an authenticating proxy) to activate identity + guards."
    },
    {
        "id": "authApp",
        "type": "ui-app",
        "name": "Auth demo",
        "uiId": "authApp",
        "root": "authApp",
        "title": "Auth demo",
        "layout": "app",
        "auth": { "mode": "none" },
        "z": "guide-auth",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gauHome",
        "type": "ui-text",
        "name": "Home text",
        "uiId": "gauHome",
        "app": "authApp",
        "mount": "authApp.content",
        "text": "Public home content — visible to everyone.",
        "order": "1",
        "z": "guide-auth",
        "x": 320,
        "y": 40,
        "wires": [[]]
    },
    {
        "id": "gauWho",
        "type": "ui-text",
        "name": "Signed in as",
        "uiId": "gauWho",
        "app": "authApp",
        "mount": "authApp.content",
        "value": {
            "kind": "user",
            "path": "name",
            "fallback": "not signed in (auth mode is 'none')"
        },
        "order": "2",
        "z": "guide-auth",
        "x": 320,
        "y": 100,
        "wires": [[]]
    },
    {
        "id": "gauAdminButton",
        "type": "ui-button",
        "name": "Go to admin",
        "uiId": "gauAdminButton",
        "app": "authApp",
        "mount": "authApp.content",
        "label": "Admin area",
        "visibleIf": {
            "kind": "reactive",
            "value": "(user?.groups ?? []).includes(\"admins\")"
        },
        "order": "3",
        "z": "guide-auth",
        "x": 320,
        "y": 160,
        "wires": [["gauNavAdmin"]]
    },
    {
        "id": "gauNavAdmin",
        "type": "ui-action",
        "name": "navigate → /admin",
        "uiId": "gauNavAdmin",
        "app": "authApp",
        "actionType": "navigate",
        "targetMode": "wire",
        "z": "guide-auth",
        "x": 540,
        "y": 160,
        "wires": [["gauAdminRoute"]]
    },
    {
        "id": "gauAdminRoute",
        "type": "ui-route",
        "name": "Admin route",
        "uiId": "gauAdminRoute",
        "app": "authApp",
        "path": "/admin",
        "title": "Admin",
        "layout": "vertical",
        "requiresGroup": "admins",
        "z": "guide-auth",
        "x": 760,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "gauAdminText",
        "type": "ui-text",
        "name": "Admin text",
        "uiId": "gauAdminText",
        "app": "authApp",
        "mount": "gauAdminRoute.content",
        "text": "Admin-only content — server-guarded by requiresGroup.",
        "order": "1",
        "z": "guide-auth",
        "x": 960,
        "y": 160,
        "wires": [[]]
    }
]
