[
    {
        "id": "guide-ui-button",
        "type": "tab",
        "label": "Guide: ui-button",
        "disabled": false,
        "info": "User-guide example for ui-button (docs/guide/nodes/ui-button.md). Import, deploy, open /webapp/guideButton/ — a primary button wired to a ui-action that opens a dialog, plus a link-variant button in linkMode 'url'."
    },
    {
        "id": "guideButton",
        "type": "ui-app",
        "name": "Button demo",
        "uiId": "guideButton",
        "root": "guideButton",
        "title": "Button demo",
        "layout": "app",
        "z": "guide-ui-button",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gBtnHeading",
        "type": "ui-text",
        "name": "Heading",
        "uiId": "gBtnHeading",
        "app": "guideButton",
        "mount": "guideButton.content",
        "text": "A button is an event source; a link button is a real hyperlink.",
        "order": "0",
        "z": "guide-ui-button",
        "x": 340,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "gBtnPrimary",
        "type": "ui-button",
        "name": "Open dialog button",
        "uiId": "gBtnPrimary",
        "app": "guideButton",
        "mount": "guideButton.content",
        "label": { "kind": "literal", "value": "Open dialog" },
        "icon": "plus",
        "variant": "primary",
        "size": "md",
        "outline": false,
        "linkMode": "button",
        "order": "1",
        "z": "guide-ui-button",
        "x": 340,
        "y": 120,
        "wires": [["gBtnOpen"]]
    },
    {
        "id": "gBtnLink",
        "type": "ui-button",
        "name": "Docs link button",
        "uiId": "gBtnLink",
        "app": "guideButton",
        "mount": "guideButton.content",
        "label": { "kind": "literal", "value": "Open the Node-RED site" },
        "variant": "link",
        "linkMode": "url",
        "href": { "kind": "literal", "value": "https://nodered.org/" },
        "order": "2",
        "z": "guide-ui-button",
        "x": 340,
        "y": 180,
        "wires": [[]]
    },
    {
        "id": "gBtnOpen",
        "type": "ui-action",
        "name": "Open the dialog",
        "uiId": "gBtnOpen",
        "app": "guideButton",
        "actionType": "open",
        "z": "guide-ui-button",
        "x": 560,
        "y": 120,
        "wires": [["gBtnDialog"]]
    },
    {
        "id": "gBtnDialog",
        "type": "ui-dialog",
        "name": "Confirmation",
        "uiId": "gBtnDialog",
        "app": "guideButton",
        "title": "Confirmation",
        "layout": "dialog",
        "modal": true,
        "closable": true,
        "z": "guide-ui-button",
        "x": 120,
        "y": 220,
        "wires": [[]]
    },
    {
        "id": "gBtnDialogText",
        "type": "ui-text",
        "name": "Dialog text",
        "uiId": "gBtnDialogText",
        "app": "guideButton",
        "mount": "dialog:gBtnDialog/content",
        "text": "The click travelled through ui-action into this dialog.",
        "order": "1",
        "z": "guide-ui-button",
        "x": 340,
        "y": 260,
        "wires": [[]]
    }
]
