[
    {
        "id": "guide-ui-component",
        "type": "tab",
        "label": "Guide: ui-component",
        "disabled": false,
        "info": "User-guide example for ui-component-definition + ui-component-instance (docs/guide/nodes/ui-component-definition.md). Import, deploy, open /webapp/guideComponent/ to see two cards from one definition."
    },
    {
        "id": "guideComponent",
        "type": "ui-app",
        "name": "Component demo",
        "uiId": "guideComponent",
