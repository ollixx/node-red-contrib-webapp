        "z": "guide-ui-component",
        "x": 340,
        "y": 100,
        "wires": [[]]
    },
    {
        "id": "gCompInst2",
        "type": "ui-component-instance",
        "name": "Second",
        "uiId": "gCompInst2",
        "app": "guideComponent",
        "mount": "guideComponent.content",
        "order": "2",
        "definition": "gCompDef",
        "props": "{\"title\":{\"kind\":\"literal\",\"value\":\"Second card\"}}",
        "z": "guide-ui-component",
        "x": 340,
        "y": 220,
        "wires": [[]]
    }
]
