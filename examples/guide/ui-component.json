        "layout": "app",
        "z": "guide-ui-component",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gCompDef",
        "type": "ui-component-definition",
        "name": "Card",
        "uiId": "gCompDef",
