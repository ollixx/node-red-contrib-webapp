[
    {
        "id": "guide-ui-stepper",
        "type": "tab",
        "label": "Guide: ui-stepper",
        "disabled": false,
        "info": "User-guide example for ui-stepper (docs/guide/nodes/ui-stepper.md). Import, deploy, open /webapp/guideStepper/. A three-step Account/Profile/Confirm wizard; activeStep reads a store and stepChange writes back (two-way loop). Note: stepChange carries params.value = step index."
    },
    {
        "id": "guideStepper",
        "type": "ui-app",
        "name": "Stepper demo",
        "uiId": "guideStepper",
        "root": "guideStepper",
        "layout": "app",
        "z": "guide-ui-stepper",
        "x": 120,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "gStepStore",
        "type": "ui-store",
        "name": "Active step store",
        "uiId": "gStepStore",
        "app": "guideStepper",
        "statePath": "activeStep",
        "initialValue": "\"account\"",
        "persist": false,
        "scope": "any",
        "z": "guide-ui-stepper",
        "x": 120,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "gStepNode",
        "type": "ui-stepper",
        "name": "Signup wizard",
        "uiId": "gStepNode",
        "app": "guideStepper",
        "mount": "guideStepper.content",
        "steps": "[{\"id\":\"account\",\"label\":\"Account\"},{\"id\":\"profile\",\"label\":\"Profile\"},{\"id\":\"confirm\",\"label\":\"Confirm\"}]",
        "activeStep": { "kind": "state", "path": "activeStep" },
        "orientation": "horizontal",
        "events": "[\"stepChange\"]",
        "order": "1",
        "z": "guide-ui-stepper",
        "x": 360,
        "y": 120,
        "wires": [["gStepToPayload"]]
    },
    {
        "id": "gStepAccountBody",
        "type": "ui-text",
        "name": "Account step body",
        "uiId": "gStepAccountBody",
        "app": "guideStepper",
        "mount": "gStepNode.account",
        "text": "Enter your account details.",
        "value": { "kind": "literal", "value": "Enter your account details." },
        "order": "0",
        "z": "guide-ui-stepper",
        "x": 620,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "gStepProfileBody",
        "type": "ui-text",
        "name": "Profile step body",
        "uiId": "gStepProfileBody",
        "app": "guideStepper",
        "mount": "gStepNode.profile",
        "text": "Fill in your profile.",
        "value": { "kind": "literal", "value": "Fill in your profile." },
        "order": "0",
        "z": "guide-ui-stepper",
        "x": 620,
        "y": 260,
        "wires": [[]]
    },
    {
        "id": "gStepConfirmBody",
        "type": "ui-text",
        "name": "Confirm step body",
        "uiId": "gStepConfirmBody",
        "app": "guideStepper",
        "mount": "gStepNode.confirm",
        "text": "Review and confirm.",
        "value": { "kind": "literal", "value": "Review and confirm." },
        "order": "0",
        "z": "guide-ui-stepper",
        "x": 620,
        "y": 320,
        "wires": [[]]
    },
    {
        "id": "gStepToPayload",
        "type": "change",
        "name": "params.value → payload",
        "z": "guide-ui-stepper",
        "rules": [
            { "t": "set", "p": "payload", "pt": "msg", "to": "ui.params.value", "tot": "msg" }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 620,
        "y": 120,
        "wires": [["gStepWriteBack"]]
    },
    {
        "id": "gStepWriteBack",
        "type": "ui-store-action",
        "name": "Write active step",
        "uiId": "gStepWriteBack",
        "app": "guideStepper",
        "store": "gStepStore",
        "op": "set",
        "path": "",
        "mode": "reference",
        "z": "guide-ui-stepper",
        "x": 860,
        "y": 120,
        "wires": [[]]
    }
]
