    {
        "type": "function",
        "id": "fnSelectCustomer",
        "name": "Select customer",
        "func": "// ui-table rowSelect → make the picked row the 'current' customer and\n// navigate to its detail route. The runtime took NO action — we do.\nconst ui = msg.ui || {};\nconst row = (ui.params && ui.params.row) || {};\nconst clientId = ui.clientId;\nflow.set('editingId', row.id);\nconst setCurrent = { ui: { clientId, store: { id: 'customersStore', op: 'set', path: 'current', value: row } } };\nconst navigate = { ui: { clientId, action: { type: 'navigate', to: '/customers/' + row.id } } };\nreturn [setCurrent, navigate];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "z": "flow1",
        "x": 120,
        "y": 860,
        "wires": [
            [
                "customersStore"
            ],
            [
                "openCustomerDetail"
            ]
        ]
    },
    {
        "type": "function",
        "id": "fnNewCustomer",
        "name": "New customer",
        "func": "const clientId = (msg.ui || {}).clientId;\nflow.set('editingId', null);\nconst blank = { name: '', email: '', status: 'trial' };\nconst resetDraft = { ui: { clientId, store: { id: 'draftStore', op: 'replace', value: blank } } };\nconst openDialog = { ui: { clientId, action: { type: 'show', target: 'dialog:customerEditor' } } };\nreturn [resetDraft, openDialog];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "z": "flow1",
        "x": 360,
        "y": 860,
        "wires": [
            [
                "draftStore"
            ],
            [
                "openCustomerEditor"
            ]
        ]
    },
    {
        "type": "function",
        "id": "fnEditCustomer",
        "name": "Edit customer",
        "func": "const clientId = (msg.ui || {}).clientId;\nconst list = flow.get('customers') || [];\nconst editingId = flow.get('editingId');\nconst current = list.find(c => c.id === editingId) || {};\nconst draft = { name: current.name || '', email: current.email || '', status: current.status || 'trial' };\nconst loadDraft = { ui: { clientId, store: { id: 'draftStore', op: 'replace', value: draft } } };\nconst openDialog = { ui: { clientId, action: { type: 'show', target: 'dialog:customerEditor' } } };\nreturn [loadDraft, openDialog];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "z": "flow1",
        "x": 600,
        "y": 860,
        "wires": [
            [
                "draftStore"
            ],
            [
                "openCustomerEditor"
            ]
        ]
    },
    {
        "type": "function",
        "id": "fnSaveCustomer",
        "name": "Save customer (create/update)",
        "func": "// The Save button sits inside the editor form, so the click POST\n// carries the field values in msg.ui.params (name, email, status).\nconst ui = msg.ui || {};\nconst clientId = ui.clientId;\nconst p = ui.params || {};\nconst list = (flow.get('customers') || []).slice();\nconst editingId = flow.get('editingId');\nconst record = { name: p.name || '', email: p.email || '', status: p.status || 'trial' };\nlet saved;\nif (editingId) {\n    saved = Object.assign({}, list.find(c => c.id === editingId), record, { id: editingId });\n    const idx = list.findIndex(c => c.id === editingId);\n    if (idx >= 0) { list[idx] = saved; } else { list.push(saved); }\n} else {\n    saved = Object.assign({ id: 'c-' + Date.now() }, record);\n    list.push(saved);\n}\nflow.set('customers', list);\nflow.set('editingId', null);\nconst setList = { ui: { clientId, store: { id: 'customersStore', op: 'set', path: 'list', value: list } } };\nconst setCurrent = { ui: { clientId, store: { id: 'customersStore', op: 'set', path: 'current', value: saved } } };\nconst closeDialog = { ui: { clientId, action: { type: 'hide', target: 'dialog:customerEditor' } } };\nreturn [setList, setCurrent, closeDialog];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "z": "flow1",
        "x": 120,
        "y": 960,
        "wires": [
            [
                "customersStore"
            ],
            [
                "customersStore"
            ],
            [
                "saveCustomer"
            ]
        ]
    },
    {
        "type": "function",
        "id": "fnDeleteCustomer",
