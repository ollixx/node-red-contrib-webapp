[
  {
    "id": "ex-ui-query",
    "type": "tab",
    "label": "ui-query example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "queryApp",
    "type": "ui-app",
    "name": "Query App",
    "uiId": "queryApp",
    "root": "queryApp",
    "layout": "app",
    "z": "ex-ui-query",
    "x": 120,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "queryRoute",
    "type": "ui-route",
    "name": "queryRoute",
    "uiId": "queryRoute",
    "path": "/",
    "parent": "queryApp",
    "layoutId": "vertical",
    "z": "ex-ui-query",
    "x": 120,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "usersQuery",
    "type": "ui-query",
    "name": "users query",
    "uiId": "usersQuery",
    "parent": "queryApp",
    "z": "ex-ui-query",
    "x": 480,
    "y": 380,
    "wires": [
      [
        "queryDbg"
      ]
    ],
    "queryPath": "users",
    "trigger": "onShow"
  },
  {
    "id": "dbFn",
    "type": "function",
    "name": "Simulate DB",
    "z": "ex-ui-query",
    "x": 380,
    "y": 520,
    "func": "// Simulate a database result.\n// In a real flow: replace this with an http-request, mongodb,\n// sqlite, or any Node-RED data node.\nmsg.payload = [\n  { id: '1', name: 'Alice', role: 'Admin' },\n  { id: '2', name: 'Bob',   role: 'Editor' },\n  { id: '3', name: 'Carol', role: 'Viewer' }\n];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "wires": [
      [
        "usersQuery"
      ]
    ]
  },
  {
    "id": "usersTable",
    "type": "ui-table",
    "name": "users table",
    "uiId": "usersTable",
    "parent": "queryApp",
    "mount": "queryRoute.content",
    "z": "ex-ui-query",
    "x": 480,
    "y": 280,
    "wires": [
      []
    ],
    "columns": "[{\"key\":\"name\",\"label\":\"Name\"},{\"key\":\"role\",\"label\":\"Role\"}]",
    "rows": {
      "kind": "query",
      "path": "users"
    }
  },
  {
    "id": "queryDbg",
    "type": "debug",
    "name": "query emit (passes through to DB node)",
    "z": "ex-ui-query",
    "x": 700,
    "y": 280,
    "active": true,
    "tosidebar": true,
    "complete": "ui",
    "targetType": "msg",
    "wires": [
      []
    ]
  },
  {
    "id": "inj-refresh",
    "type": "inject",
    "name": "Refresh data",
    "z": "ex-ui-query",
    "x": 120,
    "y": 520,
    "payload": "",
    "payloadType": "date",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "dbFn"
      ]
    ]
  }
]
