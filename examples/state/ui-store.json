[
  {
    "id": "ex-ui-store",
    "type": "tab",
    "label": "ui-store example",
    "disabled": false,
    "info": ""
  },
  {
    "id": "storeApp",
    "type": "ui-app",
    "name": "Store App",
    "uiId": "storeApp",
    "root": "storeApp",
    "layout": "app",
    "z": "ex-ui-store",
    "x": 100,
    "y": 80,
    "wires": [
      []
    ]
  },
  {
    "id": "storeHome",
    "type": "ui-route",
    "name": "storeHome",
    "uiId": "storeHome",
    "path": "/",
    "parent": "storeApp",
    "layoutId": "vertical",
    "z": "ex-ui-store",
    "x": 100,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "counterStore",
    "type": "ui-store",
    "name": "counterStore",
    "uiId": "counterStore",
    "parent": "storeApp",
    "z": "ex-ui-store",
    "x": 400,
    "y": 320,
    "wires": [
      []
    ],
    "statePath": "counter",
    "initialValue": "0"
  },
  {
    "id": "counterDisplay",
    "type": "ui-text",
    "name": "counterDisplay",
    "uiId": "counterDisplay",
    "parent": "storeApp",
    "mount": "storeHome.content",
    "z": "ex-ui-store",
    "x": 400,
    "y": 180,
    "wires": [
      []
    ],
    "value": {
      "kind": "state",
      "path": "counter"
    }
  },
  {
    "id": "ex-ui-store-inj",
    "type": "inject",
    "name": "Inject",
    "z": "ex-ui-store",
    "x": 100,
    "y": 420,
    "payload": "42",
    "payloadType": "str",
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "wires": [
      [
        "counterStore"
      ]
    ]
  },
  {
    "id": "ex-ui-store-fn",
    "type": "function",
    "name": "Increment",
    "z": "ex-ui-store",
    "x": 400,
    "y": 420,
    "func": "msg.payload = (parseInt(msg.payload) || 0) + 1;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "wires": [
      [
        "counterStore"
      ]
    ]
  }
]
